{
  "swagger": "2.0",
  "info": {
    "title": "API de Gestão de Eventos",
    "description": "API RESTful para criar eventos e inscrever participantes.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/events": {
      "post": {
        "tags": [
          "Eventos"
        ],
        "description": "Cria um novo evento.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Dados do evento a ser criado.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EventInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Evento criado com sucesso."
          },
          "400": {
            "description": "Dados inválidos."
          },
          "500": {
            "description": "Erro interno ao criar o evento."
          }
        }
      },
      "get": {
        "tags": [
          "Eventos"
        ],
        "description": "Lista todos os eventos com a contagem de inscrições atuais.",
        "responses": {
          "200": {
            "description": "Lista de eventos."
          },
          "500": {
            "description": "Erro interno ao listar os eventos."
          }
        }
      }
    },
    "/events/{id}/register": {
      "post": {
        "tags": [
          "Inscrições"
        ],
        "description": "Inscreve um participante em um evento, respeitando a capacidade máxima.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID do evento."
          },
          {
            "name": "body",
            "in": "body",
            "description": "Dados do participante.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegistrationInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Inscrição realizada com sucesso."
          },
          "400": {
            "description": "Dados inválidos."
          },
          "403": {
            "description": "Evento lotado."
          },
          "404": {
            "description": "Evento não encontrado."
          },
          "500": {
            "description": "Erro interno ao registrar participante."
          }
        }
      }
    }
  },
  "definitions": {
    "EventInput": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Workshop de Node.js"
        },
        "date": {
          "type": "string",
          "example": "2026-12-01T19:00:00.000Z"
        },
        "capacity": {
          "type": "number",
          "example": 30
        }
      }
    },
    "RegistrationInput": {
      "type": "object",
      "properties": {
        "participantName": {
          "type": "string",
          "example": "Maria Silva"
        },
        "email": {
          "type": "string",
          "example": "maria@email.com"
        }
      }
    }
  }
}